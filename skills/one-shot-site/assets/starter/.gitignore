node_modules/
dist/
# the brief and the check results stay on this machine (the brief holds guesses and private notes);
# only the list of deliberate exceptions goes into git, so the checks agree on every machine
.one-shot/*
!.one-shot/allow.json
.DS_Store
# netlify-cli links the folder to its site on the first deploy; keep that link, so every copy publishes there
.netlify/*
!.netlify/state.json
